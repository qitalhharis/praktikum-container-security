
# STAGE 1: BUILDER
FROM python:3.12-alpine@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7 AS builder
WORKDIR /build

RUN python -m pip install --no-cache-dir --upgrade pip \
    && pip wheel --no-cache-dir --wheel-dir /wheels Flask==3.1.3 setuptools==84.1.0


# STAGE 2: RUNTIME
FROM python:3.12-alpine@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7
WORKDIR /app

LABEL maintainer="Wasabi Crew"
LABEL description="Aplikasi Praktikum Container Security"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apk upgrade --no-cache

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder /wheels /wheels

RUN pip install --no-cache-dir --no-index --find-links=/wheels Flask==3.1.3 setuptools==84.1.0 \
    && rm -rf /wheels

COPY --chown=appuser:appgroup app.py .

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/')" || exit 1

EXPOSE 5000

CMD ["python", "app.py"]
